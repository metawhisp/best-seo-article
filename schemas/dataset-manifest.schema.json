{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:best-seo-article:schema:dataset-manifest:0.1",
  "title": "Best SEO Article dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "datasets"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run_id": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9]", "not": {"pattern": "[^A-Za-z0-9._-]"}},
    "datasets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataset"
      },
      "default": []
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "semanticText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-unicode-letter-or-number": true
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "not": {"pattern": "[\\u0000-\\u001F\\u007F]"},
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$)[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u034F\\u061C\\u115F-\\u1160\\u17B4-\\u17B5\\u180B-\\u180F\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u206F\\u2800\\u3164\\uFE00-\\uFE0F\\uFEFF\\uFFA0\\uFFF0-\\uFFF8]+(?![\\s\\S])"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|(?:(?![xX][nN]--)[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*(?![xX][nN]--)[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\s\\\\]*)?$",
      "not": {
        "anyOf": [
          {"pattern": "[\\u0000-\\u001F\\u007F]"},
          {"pattern": "%(?:2[fF]|5[cC])"},
          {"pattern": "%(?![0-9A-Fa-f]{2})"},
          {"pattern": "/(?:\\.|%2[eE])(?:\\.|%2[eE])?(?:/|[?#]|$)"}
        ]
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "license_id",
        "commercial_use_allowed",
        "attribution_required",
        "attribution_text"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "pending",
            "unknown"
          ]
        },
        "license_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "license_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "commercial_use_allowed": {
          "type": "boolean"
        },
        "attribution_required": {
          "type": "boolean"
        },
        "attribution_text": {
          "type": "string",
          "x-unicode-letter-or-number-when-nonempty": true
        },
        "evidence_path": {
          "$ref": "#/$defs/relativePath"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "anyOf": [
        {"required": ["license_url"]},
        {"required": ["evidence_path", "evidence_sha256"]}
      ],
      "dependentRequired": {
        "evidence_path": ["evidence_sha256"]
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "data_type",
        "description"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "data_type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "date",
            "datetime"
          ]
        },
        "description": {
          "$ref": "#/$defs/semanticText"
        },
        "unit": {
          "type": "string"
        },
        "source_field": {
          "type": "string"
        }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transform_id",
        "description",
        "spec_path",
        "spec_sha256",
        "input_sha256",
        "output_sha256"
      ],
      "properties": {
        "transform_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/semanticText"
        },
        "spec_path": {
          "$ref": "#/$defs/relativePath"
        },
        "spec_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "title",
        "publisher",
        "retrieved_at",
        "snapshot_path",
        "snapshot_sha256",
        "provenance_status",
        "synthetic",
        "methodology",
        "license",
        "fields",
        "transformations"
      ],
      "properties": {
        "dataset_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/semanticText"
        },
        "publisher": {
          "$ref": "#/$defs/semanticText"
        },
        "source_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "source_path": {
          "$ref": "#/$defs/relativePath"
        },
        "source_path_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26]))|(?:(?:0[48]|[2468][048]|[13579][26])00))-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "not": {"pattern": "[\\u0000-\\u001F\\u007F]"}
        },
        "snapshot_path": {
          "$ref": "#/$defs/relativePath"
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provenance_status": {
          "enum": [
            "verified",
            "pending",
            "unknown"
          ]
        },
        "synthetic": {
          "type": "boolean"
        },
        "methodology": {
          "$ref": "#/$defs/semanticText"
        },
        "time_range": {
          "type": "string"
        },
        "sample_size": {
          "type": "integer",
          "minimum": 0
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformation"
          },
          "default": []
        }
      },
      "anyOf": [
        {"required": ["source_url"]},
        {"required": ["source_path", "source_path_sha256"]}
      ],
      "dependentRequired": {
        "source_path": ["source_path_sha256"]
      }
    }
  }
}
